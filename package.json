{
  "name": "your-study-buddy",
  "productName": "Your Study Buddy",
  "version": "0.3.0",
  "description": "Your Study Buddy is a native, fully offline macOS study app with original study companions for biology, physiology, plant biology, general chemistry, and physical chemistry.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:syntax": "node --check dist/app.js && node --check electron/main.cjs && node --check electron/preload.cjs",
    "bundle:pdf": "esbuild dist/pdf-annotation.js --bundle --format=iife --platform=browser --target=safari16 --minify --outfile=dist/pdf-annotation.bundle.js",
    "start": "electron .",
    "make": "electron-forge make",
    "package": "electron-forge package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkai3333/Your-Study-Buddy-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "YourStudyBuddy",
        "asar": true,
        "icon": "electron/assets/your-study-buddy",
        "ignore": [
          "^/build($|/)",
          "^/macOS($|/)",
          "^/tmp($|/)",
          "^/tools($|/)",
          "^/README\\.md$",
          "^/build-mac-app\\.sh$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "your_study_buddy",
            "authors": "Kai Chen Guo",
            "description": "Offline flashcards, spaced repetition, questions, and Feynman study tools.",
            "setupExe": "Your Study Buddy Setup.exe",
            "setupIcon": "electron/assets/your-study-buddy.ico"
          }
        }
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/vkai3333/Your-Study-Buddy-/issues"
  },
  "homepage": "https://github.com/vkai3333/Your-Study-Buddy-#readme",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "fzstd": "^0.1.1",
    "pdfjs-dist": "^5.4.296",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2"
  }
}
